{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/afkzonagroup/sourcebook/schema/summary-v1.schema.json",
  "title": "Sourcebook summary file (public summary of training content, AI Act Article 53(1)(d))",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourcebook"
  ],
  "properties": {
    "sourcebook": {
      "const": 1
    },
    "summary_version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string"
        },
        "previous_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "type": "string"
              },
              "link": {
                "type": "string",
                "pattern": "^(https?://.*)?$"
              }
            }
          }
        }
      },
      "description": "Version of the Summary: Version of the summary, with link(s) to previous versions where applicable"
    },
    "last_update": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Last update: DD/MM/YY"
    },
    "general_information": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name_and_contact_details": {
              "type": "string",
              "description": "Section 1.1: Provider name and contact details:"
            },
            "authorised_representative": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "applicable": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "name_and_contact_details": {
                  "type": "string"
                },
                "not_applicable_reason": {
                  "anyOf": [
                    {
                      "enum": [
                        "established_in_union",
                        "open_source_exemption"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "description": "Section 1.1: Authorised representative name and contact details: Only applicable if the provider is established outside the Union (see Article 54 AI Act)."
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "versioned_model_names": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "documentation_links": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(https?://.*)?$"
                    }
                  }
                }
              },
              "description": "Section 1.2: Versioned model name(s): Provide the unique identifier(s) for the model(s) or model version(s) covered by this Summary (e.g. Llama 3.1-405B). In accordance with point 30 of the Commission Explanatory Notice to the Template, the same Summary may be used for different model(s) or model version(s) provided the content of their respective Summaries is identical. Where available, provide link(s) to additional publicly available documentation, such as the model card, for the model(s) or model version(s)."
            },
            "model_dependencies": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "is_modification": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "models": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "summary_link": {
                        "type": "string",
                        "pattern": "^(https?://.*)?$"
                      }
                    }
                  }
                }
              },
              "description": "Section 1.2: Model dependencies: If the model is the result of a modification, including fine-tuning, of one or more general-purpose AI models already placed on the Union market, specify the model (version) name(s) of that/those models and provide a link to their Summary(ies) where available."
            },
            "placement_dates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "date": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "description": "Section 1.2: Date of placement of the model on the Union market: Indicate the date on which the model was placed on the Union market (including the dates each model (version(s)) was placed on the market, if the Summary applies to more than one model or version (see point 30 of the Commission Explanatory Notice to the Template)."
            }
          }
        },
        "modalities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "present": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "size_range": {
                  "anyOf": [
                    {
                      "enum": [
                        "below_1b_tokens",
                        "1b_to_10t_tokens",
                        "above_10t_tokens"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "size_other_unit": {
                  "type": "string"
                },
                "types_of_content": {
                  "type": "string"
                }
              }
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "present": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "size_range": {
                  "anyOf": [
                    {
                      "enum": [
                        "below_1m_images",
                        "1m_to_1b_images",
                        "above_1b_images"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "types_of_content": {
                  "type": "string"
                }
              }
            },
            "audio": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "present": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "size_range": {
                  "anyOf": [
                    {
                      "enum": [
                        "below_10k_hours",
                        "10k_to_1m_hours",
                        "above_1m_hours"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "types_of_content": {
                  "type": "string"
                }
              }
            },
            "video": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "present": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "size_range": {
                  "anyOf": [
                    {
                      "enum": [
                        "below_10k_hours",
                        "10k_to_1m_hours",
                        "above_1m_hours"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "types_of_content": {
                  "type": "string"
                }
              }
            },
            "other": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "modality": {
                    "type": "string"
                  },
                  "approximate_size": {
                    "type": "string"
                  },
                  "types_of_content": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "description": "Section 1.3: Modality Select the modalities present in the training data, to the extent that they are identifiable"
        },
        "latest_data_collection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "continuous_training": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "description": "Section 1.3: Latest date of data acquisition/collection for model training: Indicate the latest date when data was collected/obtained for the model training: MM/YYYY Additionally, indicate if the model is continuously trained on new or dynamic data after this date."
        },
        "linguistic_characteristics": {
          "type": "string",
          "description": "Section 1.3: Description of the linguistic characteristics of the overall training data: Where applicable, describe the languages covered by the training data (e.g., text, videos or speech), focusing in particular on EU official languages."
        },
        "other_characteristics": {
          "type": "string",
          "description": "Section 1.3: Other relevant characteristics of the overall training data: Where such information is readily available and in so far as it is relevant and practicable, describe other relevant characteristics of the overall training data, such as national/regional or demographic specificities of the training data."
        },
        "additional_comments": {
          "type": "string",
          "description": "Section 1.3: Additional comments (optional): Providers may also disclose other relevant information on a voluntary basis (e.g. the compression or tokenization methodologies applied for the data size calculation, the sampling frequency/rate plays for audio or video content)."
        }
      }
    },
    "data_sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_datasets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "used": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Section 2.1: Have you used publicly available datasets to train the model?"
            },
            "modalities": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "selected": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "text",
                      "image",
                      "video",
                      "audio"
                    ]
                  }
                },
                "other": {
                  "type": "string"
                }
              }
            },
            "large_datasets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "link": {
                    "type": "string",
                    "pattern": "^(https?://.*)?$"
                  },
                  "description": {
                    "type": "string"
                  },
                  "collection_period": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "start": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^([0-9]{4}-(0[1-9]|1[0-2])|not known)$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "end": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^([0-9]{4}-(0[1-9]|1[0-2])|not known)$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "selection_approach": {
                    "type": "string"
                  }
                }
              },
              "description": "Section 2.1: List of large publicly available datasets: For each large dataset, provide the identifier/name of the dataset and a link through which the dataset can be accessed. If a link is not available, provide a general description of the dataset, including the approximate start and end dates of the data collection if known (otherwise indicate “not known”). If only part of the datasets has been used for the training, indicate the general approach to selecting those parts."
            },
            "other_datasets_description": {
              "type": "string",
              "description": "Section 2.1: General description of other publicly available datasets not listed above: For other publicly available datasets that are not listed above, provide a general description of their content. The description could include indication of: (i) the types of modality (e.g. text, images), (ii) nature of the content (e.g. personal data, copyright protected content, machine generated data such as Internet of Things or synthetic data), (iii) its linguistic characteristics, where applicable. (iv) the approximate start and end dates of the data collection if known (otherwise indicate “not known”)."
            },
            "additional_comments": {
              "type": "string"
            }
          }
        },
        "licensed_datasets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "concluded": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Section 2.2.1: Have you concluded transactional commercial licensing agreement(s) with rightsholder(s) or with their representatives?"
            },
            "modalities": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "selected": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "text",
                      "image",
                      "video",
                      "audio"
                    ]
                  }
                },
                "other": {
                  "type": "string"
                }
              }
            }
          }
        },
        "other_private_datasets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "obtained": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Section 2.2.2: Have you obtained private datasets from third parties that are not licensed as described in Section 2.2.1, such as data obtained from providers of private databases, or data intermediaries?"
            },
            "modalities": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "selected": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "text",
                      "image",
                      "video",
                      "audio"
                    ]
                  }
                },
                "other": {
                  "type": "string"
                }
              }
            },
            "publicly_known_datasets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "link": {
                    "type": "string",
                    "pattern": "^(https?://.*)?$"
                  }
                }
              },
              "description": "Section 2.2.2: If publicly known, list private datasets obtained from other third parties: If publicly known, list the identifiers/names of the main private datasets from third parties that are not licensed as described in Section 2.2.1 and that are used to train the model, and provide links to relevant information, where available."
            },
            "non_publicly_known_description": {
              "type": "string",
              "description": "Section 2.2.2: General description of non-publicly known private datasets obtained from third parties For those private datasets used to train the model that are not publicly known and whose identifiers are not listed above, provide a general description of their content. The description should indicate (i) the modalities (e.g,, text, images), (ii) nature of the content (e.g., personal data, copyright protected content, machine generated data such as Internet of Things or synthetic data) and (iii) its linguistic characteristics, where applicable."
            },
            "additional_comments": {
              "type": "string"
            }
          }
        },
        "crawled_data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "crawlers_used": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Section 2.3: Were crawlers used by the provider or on behalf of?"
            },
            "crawler_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "purposes": {
              "type": "string"
            },
            "crawler_behaviour": {
              "type": "string",
              "description": "Section 2.3: General description of crawler behaviour: For example, this includes respect of captchas, password protected websites and paywalls, respect of robot.txt and other protocols, while crawling."
            },
            "collection_period": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "to": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "content_description": {
              "type": "string",
              "description": "Section 2.3: Comprehensive description of the type of content and online sources crawled: Provide a comprehensive description of the type of content crawled, including its geographical, linguistic or demographic characteristics, as well as an indication of the type of websites scraped (e.g. news, blogs, social media, forums, community websites, other user-generated content platforms, websites of cultural heritage institutions, educational sites, government portals, personal blogs, streaming, gaming platforms, online TV platforms, synthetic data libraries, etc)."
            },
            "modalities": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "selected": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "text",
                      "image",
                      "video",
                      "audio"
                    ]
                  }
                },
                "other": {
                  "type": "string"
                }
              }
            },
            "top_domains": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "domains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "access_information": {
                  "type": "string"
                }
              },
              "description": "Section 2.3: Summary of the most relevant domain names crawled: In so far as any content from internet domains has been crawled or scraped and used for the training of the model, provide a list of those most relevant internet domains names (top and second-level domain, e.g. “example.com”) by listing the top 10 % of all domain names determined by the size of the content scraped (in a representative manner across all modalities where applicable). Small and medium-sized enterprises (SMEs), including start-ups, should disclose top 5% of all domain names or 1 000 internet domain names, whichever is lower. You can provide this list for instance as a downloadable file or provide here information on how to access it."
            },
            "additional_comments": {
              "type": "string"
            }
          }
        },
        "user_data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from_model_interactions": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Section 2.4: Was data from user interactions with the AI model (e.g. user input and prompts) used to train the model?"
            },
            "from_other_services": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Section 2.4: Was data collected from user interactions with the provider’s other services or products used to train the model?"
            },
            "services_description": {
              "type": "string"
            },
            "modalities": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "selected": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "text",
                      "image",
                      "video",
                      "audio"
                    ]
                  }
                },
                "other": {
                  "type": "string"
                }
              }
            },
            "additional_comments": {
              "type": "string"
            }
          }
        },
        "synthetic_data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "created": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Section 2.5: Was synthetic AI-generated data created by the provider or on their behalf to train the model?"
            },
            "modalities": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "selected": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "text",
                      "image",
                      "video",
                      "audio"
                    ]
                  }
                },
                "other": {
                  "type": "string"
                }
              }
            },
            "market_models": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "summary_link": {
                    "type": "string",
                    "pattern": "^(https?://.*)?$"
                  }
                }
              }
            },
            "other_models_information": {
              "type": "string",
              "description": "Section 2.5: Information about other AI models, including provider’s own AI model(s) not available on the market, used to generate synthetic data to train the model to which this Summary applies: Provide information about other AI models used to generate synthetic data, including provider’s own models if not available on the market. This includes a general description of the model training data if known and in so far as this may be needed for the exercise of the rights of parties with legitimate interests and to avoid circumvention of the disclosure obligations in the other Sections of the Template."
            },
            "additional_comments": {
              "type": "string"
            }
          }
        },
        "other_sources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "used": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Section 2.6: Have data sources other than those described in Sections 2.1 to 2.5 been used to train the model?"
            },
            "description": {
              "type": "string"
            },
            "additional_comments": {
              "type": "string"
            }
          }
        }
      }
    },
    "data_processing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tdm_reservations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code_of_practice_signatory": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Section 3.1: Are you a Signatory to the Code of Practice for general-purpose AI models that includes commitments to respect reservations of rights from the TDM exception or limitation?"
            },
            "measures": {
              "type": "string",
              "description": "Section 3.1: Describe the measures implemented before model training to respect reservations of rights from the TDM exception or limitation before and during data collection, including the opt-out protocols and solutions honoured by the provider or, as applicable, by third parties from which datasets have been obtained:"
            },
            "additional_comments": {
              "type": "string"
            }
          }
        },
        "illegal_content": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "measures": {
              "type": "string",
              "description": "Section 3.2: General description of measures taken:"
            }
          }
        },
        "other_information": {
          "type": "string",
          "description": "Section 3.3: Other relevant information about data processing (optional): Providers are also encouraged to disclose on a voluntary basis other relevant information about relevant data processing aspects and measures taken before or after the training of the model that is relevant for the respect and exercise of rights  protected under Union law."
        }
      }
    },
    "information_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "enum": [
              "summary_version",
              "last_update",
              "provider",
              "authorised_representative",
              "versioned_model_names",
              "model_dependencies",
              "placement_dates",
              "modalities",
              "latest_data_collection",
              "linguistic_characteristics",
              "other_characteristics",
              "general_additional_comments",
              "public_datasets_used",
              "public_datasets_modalities",
              "large_public_datasets",
              "other_public_datasets",
              "public_datasets_additional_comments",
              "licensed_datasets_concluded",
              "licensed_datasets_modalities",
              "other_private_datasets_obtained",
              "other_private_datasets_modalities",
              "publicly_known_private_datasets",
              "non_publicly_known_private_datasets",
              "other_private_datasets_additional_comments",
              "crawlers_used",
              "crawler_names",
              "crawler_purposes",
